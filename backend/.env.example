# ─────────────────────────────────────────────────────────────
# VoteSmart Backend — Environment Configuration
# Copy this file: cp backend/.env.example backend/.env
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SERVER ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev:        http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=http://localhost:3000

# ── OPTIONAL: API Key Auth ───────────────────────────────────
# Set this to require callers to send X-Api-Key: <value> header.
# Leave commented/empty to disable (open access, fine for dev).
# BACKEND_API_KEY=your-secret-backend-key-here
