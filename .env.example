# ─────────────────────────────────────────────────────────────
# VoteSmart — Root Environment (docker-compose)
# Copy to .env: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS: frontend origin (your domain in production) ────────
FRONTEND_URL=http://localhost

# ── React production API URL (must be reachable from browser) 
REACT_APP_API_URL=http://localhost:5000/api

# ── OPTIONAL: API Key Auth ───────────────────────────────────
# Must match BACKEND_API_KEY in backend/.env if set.
# BACKEND_API_KEY=your-secret-backend-key-here
# REACT_APP_API_KEY=your-secret-backend-key-here
